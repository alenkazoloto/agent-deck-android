<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ gates the shade behind a runtime grant; the app asks in context, after
         the first pairing, never on cold start. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only exercised while "Stay connected in the background" is on, which is opt-in and off
         by default; the service posts an ongoing row naming what it is holding. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      The app is sideloaded, so nothing else on the phone ever offers it a newer build. This is
      what lets Settings hand a downloaded APK to Android's own installer; the *decision* is
      still the user's, on the system install screen, and Android 8+ additionally gates this
      behind a per-app "install unknown apps" setting the manifest cannot grant itself.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Dictation hands off to whatever app answers RECOGNIZE_SPEECH, so this app needs no
      RECORD_AUDIO. Android 11+ hides other packages unless they are declared here, and
      without this the resolve returns empty and the mic button never appears at all.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!--
          Android 11+ hides other packages, and a push distributor is by definition another
          app. Without this the query returns empty, the Settings screen offers no distributor
          to choose, and the failure looks like "no distributor is installed" on a phone that
          has one.
        -->
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AgentDeck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AgentDeck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Deep links. A notification, the widget and the tile all address the app the same
              way, so there is one route into a conversation rather than three sets of extras
              that can disagree. `singleTask` is what makes a second tap land in onNewIntent
              rather than stacking a second copy of the app over the first.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agentdeck" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.StreamService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".notify.NotifyReceiver"
            android:exported="false" />

        <!--
          The UnifiedPush distributor's replies. Exported because the distributor is a
          *different app* broadcasting into this one, which is the whole mechanism — and safe
          because nothing is acted on that does not decrypt under this device's own key
          (`push/WebPushKeys.kt`): a forged MESSAGE is an authentication failure, not a
          trusted-sender question.
        -->
        <receiver
            android:name=".push.UnifiedPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
            </intent-filter>
        </receiver>

        <!--
          A downloaded APK lives in this app's cache and is handed to the installer as a
          `content://` URI: a `file://` one has thrown FileUriExposedException since Android 7.
          `dev.agentdeck.companion.data.ApkInstall` builds the same authority from the package
          name — the two strings must not drift.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".ambient.DeckWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deck_widget_info" />
        </receiver>

        <service
            android:name=".ambient.DeckTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_deck"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
