<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ gates the shade behind a runtime grant; the app asks in context, after
         the first pairing, never on cold start. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only exercised while "Stay connected in the background" is on, which is opt-in and off
         by default; the service posts an ongoing row naming what it is holding. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Dictation hands off to whatever app answers RECOGNIZE_SPEECH, so this app needs no
      RECORD_AUDIO. Android 11+ hides other packages unless they are declared here, and
      without this the resolve returns empty and the mic button never appears at all.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AgentDeck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AgentDeck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Deep links. A notification, the widget and the tile all address the app the same
              way, so there is one route into a conversation rather than three sets of extras
              that can disagree. `singleTask` is what makes a second tap land in onNewIntent
              rather than stacking a second copy of the app over the first.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agentdeck" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.StreamService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".notify.NotifyReceiver"
            android:exported="false" />

        <receiver
            android:name=".ambient.DeckWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deck_widget_info" />
        </receiver>

        <service
            android:name=".ambient.DeckTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_deck"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
